{
  "name": "mindscape-local-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "assets": "node scripts/generate-worlds.mjs && node scripts/generate-landmarks.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/browser.mjs",
    "dev:cloudflare": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "deploy:gateway": "node scripts/cloudflare-gateway.mjs",
    "test:cloudflare": "node tests/cloudflare-smoke.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "@phosphor-icons/react": "2.1.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "three": "0.180.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "autoprefixer": "10.4.21",
    "https-proxy-agent": "7.0.6",
    "playwright": "1.58.2",
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "vite": "6.4.3",
    "wrangler": "^4.147.0"
  }
}
